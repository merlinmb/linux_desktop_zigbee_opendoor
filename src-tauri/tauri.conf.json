{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "package": {
    "productName": "Open Door Monitor",
    "version": "1.0.18"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.merlin.opendoor-monitor",
      "publisher": "merlinmb",
      "shortDescription": "Zigbee door/window sensor monitor overlay",
      "longDescription": "A lightweight always-on-top desktop overlay for Linux that monitors Zigbee contact sensors (doors, windows, gates) via MQTT/Zigbee2MQTT.",
      "targets": [
        "appimage",
        "deb"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.png"
      ],
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ]
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "dock",
        "title": "Open Door Monitor",
        "width": 400,
        "height": 200,
        "x": 0,
        "y": 0,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "minWidth": 400,
        "minHeight": 200,
        "maxWidth": 400,
        "maxHeight": 200,
        "focus": true,
        "visible": true
      }
    ],
    "allowlist": {
      "all": false,
      "window": {
        "startDragging": true
      }
    }
  }
}
